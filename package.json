{
	"name": "necofuryai.dev",
	"type": "module",
	"version": "0.0.1",
	"license": "MIT",
	"author": "necofuryai",
	"scripts": {
		"dev": "astro dev",
		"start": "astro dev",
		"check": "astro check",
		"build": "astro build && pagefind --site dist --silent",
		"preview": "astro preview",
		"astro": "astro",
		"type-check": "astro sync && tsc --noEmit",
		"new-post": "node scripts/new-post.js",
		"fetch-playlists": "node --env-file-if-exists=.env scripts/fetch-playlists.mjs",
		"diff-skills": "node scripts/diff-cloudflare-skills.mjs",
		"format": "biome format --write .",
		"lint": "biome check --write .",
		"test:ui": "playwright test",
		"test:unit": "node --test tests/unit/*.test.mjs",
		"preinstall": "node scripts/check-package-manager.js"
	},
	"dependencies": {
		"@astrojs/check": "^0.9.9",
		"@astrojs/markdown-remark": "7.2.2",
		"@astrojs/rss": "^4.0.18",
		"@astrojs/sitemap": "^3.7.3",
		"@astrojs/svelte": "9.0.1",
		"@expressive-code/core": "^0.44.0",
		"@expressive-code/plugin-collapsible-sections": "^0.44.0",
		"@expressive-code/plugin-line-numbers": "^0.44.0",
		"@fontsource-variable/jetbrains-mono": "^5.2.8",
		"@fontsource/roboto": "^5.2.9",
		"@iconify-json/fa6-brands": "^1.2.6",
