		"rehype-components": "^0.3.0",
		"rehype-katex": "^7.0.1",
		"rehype-slug": "^6.0.0",
		"remark-directive": "^4.0.0",
		"remark-directive-rehype": "^1.0.0",
		"remark-github-admonitions-to-directives": "^2.1.0",
		"remark-math": "^6.0.0",
		"remark-sectionize": "^2.1.0",
		"sanitize-html": "^2.17.0",
		"sharp": "^0.35.3",
		"stylus": "^0.64.0",
		"svelte": "^5.46.4",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"unist-util-visit": "^5.0.0"
	},
	"devDependencies": {
		"@astrojs/ts-plugin": "^1.10.9",
		"@biomejs/biome": "2.5.6",
		"@playwright/test": "1.62.0",
		"@types/hast": "^3.0.4",
		"@types/markdown-it": "^14.1.2",
		"@types/mdast": "^4.0.4",
		"@types/sanitize-html": "^2.16.0"
	},
	"packageManager": "pnpm@10.34.5",
	"engines": {
		"node": ">=22.12.0"
	},
	"pnpm": {
		"allowBuilds": {
			"@parcel/watcher": true,
			"esbuild": true,
			"swup": false
		},
		"overrides": {
			"axios": ">=1.18.1",
			"form-data": ">=4.0.6",
			"follow-redirects": ">=1.16.0",
			"tar": "^7.5.21",
			"rollup@<2.80.0": "2.80.0",
			"serialize-javascript@<7.0.5": "7.0.5",
			"@swup/plugin@<4": "^4.0.0",
			"minimatch@<10.2.2": "^10.2.5",
			"brace-expansion@<5.0.8": "^5.0.8"
		}
	}
