		"@swup/astro": "^1.8.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"astro": "7.1.6",
		"astro-expressive-code": "^0.44.0",
		"astro-icon": "^1.1.5",
		"hastscript": "^9.0.1",
		"katex": "^0.18.1",
		"markdown-it": "^14.1.0",
		"markdown-it-container": "^4.0.0",
		"mdast-util-to-string": "^4.0.0",
		"overlayscrollbars": "^2.12.0",
		"pagefind": "^1.4.0",
		"photoswipe": "^5.4.4",
		"reading-time": "^1.5.0",
