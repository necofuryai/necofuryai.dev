---
import AppleMusicPlaylist from "@components/AppleMusicPlaylist.astro";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import type { PlaylistData } from "../types/playlist";

// src/data/playlists/*.json を自動収集し、fetch-playlists.mjs が書き出す order 順に表示する。
// プレイリストの追加はスクリプト側の PLAYLISTS 配列 + pnpm fetch-playlists だけで完結する
const modules = import.meta.glob<{ default: PlaylistData }>(
	"../data/playlists/*.json",
	{ eager: true },
);
const playlists = Object.values(modules)
	.map((module) => module.default)
	.sort((a, b) => a.order - b.order);
---

<MainGridLayout
	title={i18n(I18nKey.playlists)}
	description="Apple Music で聴いているプレイリストの紹介"
>
	<div class="flex w-full flex-col gap-4">
		<div class="card-base px-9 py-6 rounded-[var(--radius-large)]">
			<h1 class="text-3xl font-bold text-90">{i18n(I18nKey.playlists)}</h1>
			<p class="mt-2 text-75">
				Apple Music で聴いているプレイリスト。アートワークの再生ボタンで 30
				秒試聴でき、各曲のリンクから Apple Music で開けます。
			</p>
		</div>
		{playlists.map((playlist) => <AppleMusicPlaylist playlist={playlist} />)}
		<p class="px-2 text-xs text-30">
			トラックデータ、アートワーク、30 秒試聴音源は Apple Music API
			から取得しています。Apple および Apple Music は Apple Inc. の商標です。
		</p>
		<!-- 長い曲一覧の末尾から折りたたみ、先頭の summary へフォーカスを戻す。
		     document へのイベント委譲とガードにより、Swup 遷移後も多重登録せず動作する -->
		<script is:inline>
			(() => {
				if (document.documentElement.hasAttribute("data-am-track-list-ready")) {
					return;
				}
				document.documentElement.setAttribute("data-am-track-list-ready", "");

				document.addEventListener("click", (event) => {
					const target = event.target instanceof Element ? event.target : null;
					const button = target?.closest("[data-am-collapse-tracks]");
					if (!button) {
						return;
					}
					const details = button.closest("details");
					if (!(details instanceof HTMLDetailsElement)) {
						return;
					}
					details.open = false;
					const summary = details.querySelector("summary");
					if (summary instanceof HTMLElement) {
						summary.focus();
					}
				});
			})();
		</script>
		<!-- 30 秒試聴プレイヤー: 共有 <audio> 1 本を全トラックで使い回す。
		     ガードと document へのイベント委譲により、Swup 再訪後も多重登録しない。
		     audio は body 直下にあり Swup の差し替え対象 (main / #toc) の外で
		     生き続けるため、content:replace で必ず停止する -->
		<script is:inline>
			(() => {
				if (document.documentElement.hasAttribute("data-am-preview-ready")) {
					return;
				}
				document.documentElement.setAttribute("data-am-preview-ready", "");
				let audio = null;
				let activeButton = null;
				const stop = () => {
					audio?.pause();
					if (activeButton) {
						activeButton.removeAttribute("data-am-playing");
						activeButton.setAttribute("aria-pressed", "false");
						activeButton = null;
					}
				};
				document.addEventListener("click", (event) => {
					const target = event.target instanceof Element ? event.target : null;
					if (!target) {
						return;
					}
					const button = target.closest("[data-am-preview-url]");
					if (!button) {
						return;
					}
					if (button === activeButton) {
						stop();
						return;
					}
					stop();
					if (!audio) {
						audio = document.createElement("audio");
						audio.preload = "none";
						audio.setAttribute("data-am-preview-audio", "");
						audio.addEventListener("ended", stop);
						audio.addEventListener("error", stop);
						// メディアキーや Global Media Controls などスクリプト外の一時停止でも
						// ボタン状態を同期する。トラック切替時はキュー経由の pause イベントが
						// 届く時点で新しい再生が始まり audio.paused が false のため誤発火しない
						audio.addEventListener("pause", () => {
							if (audio.paused) {
								stop();
							}
						});
						document.body.append(audio);
					}
					audio.src = button.getAttribute("data-am-preview-url") ?? "";
					activeButton = button;
					button.setAttribute("data-am-playing", "");
					button.setAttribute("aria-pressed", "true");
					audio.play().catch(() => {
						// 別トラックへの切替による中断 (AbortError) では新しい再生を殺さない
						if (activeButton === button) {
							stop();
						}
					});
				});
				document.addEventListener("swup:content:replace", stop);
			})();
		</script>
	</div>
</MainGridLayout>
