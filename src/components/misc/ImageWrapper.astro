---
import path from "node:path";

interface Props {
	id?: string;
	src: string;
	class?: string;
	alt?: string;
	position?: string;
	basePath?: string;
	/**
	 * 画面幅いっぱい・高さ coverHeightVh (vh) の枠を object-fit: cover で埋める画像のとき
	 * に指定する。ローカルのラスター画像に srcset を付け、縦長の画面で画像が 100vw より
	 * 広く描かれることを sizes に反映する。SVG は単一の src のまま。
	 */
	coverHeightVh?: number;
	/** ファーストビューの画像。遅延読み込みをやめ、高い優先度で取得する */
	priority?: boolean;
}

import { Image } from "astro:assets";
import { coverImageSrcset } from "../../utils/cover-image-srcset.mjs";
import { url } from "../../utils/url-utils";

const {
	id,
	src,
	alt,
	position = "center",
	basePath = "/",
	coverHeightVh,
	priority,
} = Astro.props;
const className = Astro.props.class;

const isLocal = !(
	src.startsWith("/") ||
	src.startsWith("http") ||
	src.startsWith("https") ||
	src.startsWith("data:")
);
const isPublic = src.startsWith("/");

// TODO temporary workaround for images dynamic import
// https://github.com/withastro/astro/issues/3373
// biome-ignore lint/suspicious/noImplicitAnyLet: <check later>
let img;
if (isLocal) {
	// 画像拡張子に限定する: "../../**" だと src/ 以下の全モジュール(CSS 含む)が
	// バンドルに載ってしまい、スタイルの読み込みが glob の副作用に依存してしまう。
	// スタイルは Layout.astro で明示的に import する
	const files = import.meta.glob<ImageMetadata>(
		"../../**/*.{png,jpg,jpeg,webp,gif,svg,avif}",
		{
			import: "default",
		},
	);
	let normalizedPath = path
		.normalize(path.join("../../", basePath, src))
		.replace(/\\/g, "/");
	const file = files[normalizedPath];
	if (!file) {
		// 以前は console.error の後で undefined を呼び、原因の分からない TypeError で
		// ビルドが落ちていた (saicaca/fuwari#185)。バナーとアバターは
		// scripts/prepare-site-assets.mjs が dev と build の前に書き出す
		throw new Error(
			`Image file not found: ${normalizedPath.replace("../../", "src/")}`,
		);
	}
	img = await file();
}

// 寸法と形式は clone から読む。Astro の画像プロキシは clone と fsPath 以外の
// プロパティを読むと原本を「直接使われている」と記録し、ビルドで dist に残す。
// 直接読むと、srcset を作るだけでバナーの原本まで配信されてしまう。clone はプロキシが
// 実行時に返すコピーで ImageMetadata の型には無い (Astro の getImage も同じ読み方をする)
const meta = (img as (ImageMetadata & { clone?: ImageMetadata }) | undefined)
	?.clone ?? img;
const responsive =
	meta && coverHeightVh !== undefined && meta.format !== "svg"
		? coverImageSrcset(meta.width, meta.height, coverHeightVh)
		: undefined;

const imageClass = "w-full h-full object-cover";
const imageStyle = `object-position: ${position}`;
---
<div id={id} class:list={[className, 'overflow-hidden relative']}>
    <div class="transition absolute inset-0 dark:bg-black/10 pointer-events-none"></div>
    {isLocal && img && <Image src={img} alt={alt || ""} class={imageClass} style={imageStyle} widths={responsive?.widths} sizes={responsive?.sizes} priority={priority}/>}
    {!isLocal && <img src={isPublic ? url(src) : src} alt={alt || ""} class={imageClass} style={imageStyle} fetchpriority={priority ? "high" : undefined}/>}
</div>
