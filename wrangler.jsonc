{
	"name": "necofuryai-dev",
	"compatibility_date": "2026-07-22",
	"workers_dev": false,
	"routes": [
		{
			"pattern": "necofuryai.dev",
			"custom_domain": true
		}
	],
	"observability": {
		"enabled": false,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": false,
			"persist": true,
			"head_sampling_rate": 1
		}
	},
	"assets": {
		"directory": "./dist/",
		"not_found_handling": "404-page",
		"html_handling": "force-trailing-slash"
	}
}
