# build output
dist/

# playwright
playwright-report/
test-results/

# generated types
.astro/

# dependencies
node_modules/
.pnpm-store/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# commissioned artwork (banner and avatar): kept out of the public repository.
# Originals live in .site-assets/ locally and in a private R2 bucket for Workers
# Builds; scripts/prepare-site-assets.mjs writes witch-banner.webp, witch-avatar.webp,
# the social image public/og/witch-banner.jpg, and the favicons in public/favicon/
# (and their temporary files) before each build.
.site-assets/
src/assets/images/witch-*
public/og/
public/favicon/

# wrangler state (r2 object get/put without --remote write local copies here)
.wrangler/

# environment variables
.env*
!.env.example

# macOS-specific files
.DS_Store

.vercel

package-lock.json
bun.lockb
yarn.lock

# ide
.idea
*.iml

# claude code
# .claude/skills/ はデプロイ先 (Workers Static Assets) に紐づいた知識なので追跡する。
# .claude/launch.json は意図的に追跡しない (dev/preview のコマンドは AGENTS.md に既出で、
# 固有情報は preview を 4322 に逃がす作業習慣だけ)。ローカル除外は .git/info/exclude 側。
.claude/settings.local.json
.claude/.cc-writes/

# local scratch for temporary files (never committed; Biome force-ignores it too)
tmp/
